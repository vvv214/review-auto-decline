{
  "manifest_version": 3,
  "name": "Review Auto Decline",
  "version": "2.1",
  "description": "Declines journal peer-review invitations in Outlook Web and deletes them, plus the registration and decline-confirmation emails.",
  "key": "",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Review Auto Decline"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "outlook.js"
      ]
    }
  ]
}
